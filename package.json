{
  "name": "@meshkati/pi-claude-btw",
  "version": "0.2.0",
  "description": "/btw for pi: ask a side question without interrupting the agent, modeled on Claude Code's /btw",
  "type": "module",
  "license": "MIT",
  "author": "meshkati",
  "keywords": [
    "pi-package",
    "pi-extension",
    "btw",
    "side-question"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meshkati/pi-claude-btw.git"
  },
  "homepage": "https://github.com/meshkati/pi-claude-btw#readme",
  "bugs": {
    "url": "https://github.com/meshkati/pi-claude-btw/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/btw.ts"
    ],
    "image": "https://raw.githubusercontent.com/Meshkati/pi-claude-btw/main/media/cover.png",
    "video": "https://github.com/Meshkati/pi-claude-btw/raw/main/media/demo.mp4"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test test/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
